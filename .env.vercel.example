# Vercel production — set in Project → Settings → Environment Variables
# NEVER commit real secrets to git.

NODE_ENV=production

# Your deployed origin (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Strong secret for signed client share links (min 16 chars)
INVOICE_ACCESS_SECRET=replace-with-long-random-secret-min-24-chars

# Auth for public deployments (or STUDIO_AUTH_DISABLED=true for private demo)
STUDIO_AUTH_DISABLED=false
STUDIO_PASSWORD=replace-with-strong-password
SESSION_SECRET=replace-with-long-random-session-secret-min-24-chars

# --- Storage (pick ONE; auto-injected when connected in Vercel Storage tab) ---

# Option A — Neon Postgres (recommended on Vercel)
# POSTGRES_URL=postgresql://...
# DATABASE_URL=postgresql://...

# Option B — Vercel Blob
# BLOB_READ_WRITE_TOKEN=

# Optional: force a driver when both are linked
# STORAGE_DRIVER=postgres

INVOICE_PDF_ENABLED=true
NEXT_PUBLIC_INVOICE_PDF_ENABLED=true

NEXT_PUBLIC_STORE_PHONE=+91 98765 43210
STORE_PHONE=+91 98765 43210
