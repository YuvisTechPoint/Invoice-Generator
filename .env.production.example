# Production environment — copy to .env.production and customize
NODE_ENV=production

# Public URL (HTTPS in production)
NEXT_PUBLIC_SITE_URL=https://invoices.example.com

# Strong secret for client share links (required)
INVOICE_ACCESS_SECRET=replace-with-long-random-secret-min-24-chars

# Auth: set STUDIO_AUTH_DISABLED=true for trusted private networks only
STUDIO_AUTH_DISABLED=false
STUDIO_PASSWORD=replace-with-strong-password
SESSION_SECRET=replace-with-long-random-session-secret-min-24-chars

# Persistent invoice storage (Docker volume mounted at /data)
DATA_DIR=/data

# PDF via system Chromium in Docker
INVOICE_PDF_ENABLED=true
NEXT_PUBLIC_INVOICE_PDF_ENABLED=true
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

# Business defaults on invoices
NEXT_PUBLIC_STORE_PHONE=+91 98765 43210
STORE_PHONE=+91 98765 43210
