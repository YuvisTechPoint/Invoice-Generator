# Public site origin (used in absolute share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Client share link signing (use a long random value in production)
INVOICE_ACCESS_SECRET=dev-invoice-access-secret-change-in-prod

# Local dev: open access without login
STUDIO_AUTH_DISABLED=true

# Enable auth locally by setting STUDIO_AUTH_DISABLED=false and:
# STUDIO_PASSWORD=your-password
# SESSION_SECRET=dev-only-session-secret-min-24-chars-long

# Optional persistent data directory (defaults to ./data)
# DATA_DIR=./data

# Storage driver: auto (blob when BLOB_READ_WRITE_TOKEN is set, else filesystem)
# STORAGE_DRIVER=filesystem

NEXT_PUBLIC_STORE_PHONE=+91 98765 43210
STORE_PHONE=+91 98765 43210

INVOICE_PDF_ENABLED=true
NEXT_PUBLIC_INVOICE_PDF_ENABLED=true
