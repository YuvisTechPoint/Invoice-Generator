# Public site origin (used in absolute links if needed)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Studio login password (required in production)
STUDIO_PASSWORD=change-me-strong-password

# HMAC secret for studio session cookies (min 24 chars, required in production)
SESSION_SECRET=change-me-session-secret-min-24-chars

# Signed tokens for guest invoice HTML/PDF links
INVOICE_ACCESS_SECRET=change-me-invoice-access-secret
GUEST_ORDER_ACCESS_SECRET=change-me-invoice-access-secret

# Optional: override data directory (defaults to ./data)
# DATA_DIR=/var/lib/invoice-studio/data

# Contact shown on invoices / settings defaults
NEXT_PUBLIC_STORE_PHONE=+91 98765 43210
STORE_PHONE=+91 98765 43210

# PDF generation (Puppeteer). Disable to fall back to HTML print.
INVOICE_PDF_ENABLED=true
NEXT_PUBLIC_INVOICE_PDF_ENABLED=true
